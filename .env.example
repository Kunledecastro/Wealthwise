# ---------------------------------------------------------------
# Wealthwise — example configuration. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders.
# ---------------------------------------------------------------

# --- Product ---
APP_NAME=Wealthwise
APP_ENV=development              # development | test | production
APP_BASE_URL=http://localhost:3000
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos
DEMO_MODE=false                  # true = allow clearly-labelled sample data

# --- Database ---
POSTGRES_DB=wealthwise
POSTGRES_USER=wealthwise_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://wealthwise_app:change-me-local-only@db:5432/wealthwise
MIGRATOR_DATABASE_URL=postgresql+psycopg://wealthwise_migrator:change-me-local-only@db:5432/wealthwise

# --- Security ---
SECRET_KEY=generate-with-python-secrets-token_urlsafe-64
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_DAYS=7
COOKIE_SECURE=false              # must be true in production
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
UPLOAD_MAX_MB=10
UPLOAD_MAX_ROWS=20000

# --- Email (password reset). Local dev logs emails to console. ---
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- AI (optional; core app works without it) ---
AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=                    # set after hardware test, e.g. a small instruct model
AI_TIMEOUT_SECONDS=30
# External model providers are disabled unless the user explicitly consents.
EXTERNAL_AI_ALLOWED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_REDACT_FINANCIAL=true
