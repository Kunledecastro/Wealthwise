# ---------------------------------------------------------------
# Wealthwise — example configuration. Copy to .env and edit.
# NEVER commit a real .env. All values below are placeholders.
# Use letters and digits only for database passwords.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------

# --- Product ---
APP_NAME=Wealthwise
APP_ENV=development              # development | production
APP_BASE_URL=http://localhost:3000   # the address people type in the browser
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos
REGISTRATION_MODE=invite_only    # invite_only | closed
DEMO_MODE=false                  # true adds "Simulate bank events" (fake, clearly labelled demo data)
UPLOAD_MAX_MB=10                 # largest statement file accepted (1-50)
WEB_PORT=3000
WEB_BIND=127.0.0.1                # set 0.0.0.0 only if other LAN devices must reach :3000 directly

# --- Database (three separate roles) ---
POSTGRES_DB=wealthwise
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeMeSuperuser1
WW_MIGRATOR_PASSWORD=changeMeMigrator1
WW_APP_PASSWORD=changeMeApp1

# --- Security ---
SECRET_KEY=replace-with-a-long-random-value-from-the-command-above
COOKIE_SECURE=false              # MUST be true in production (HTTPS)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email (password reset). "console" prints emails in the api logs (dev only). ---
EMAIL_BACKEND=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# --- Production only ---
DOMAIN=                          # e.g. money.example.com (used by Caddy for TLS)

# --- Logging ---
LOG_LEVEL=INFO

# --- AI (Phase 10; not used yet) ---
# AI_ENABLED=false
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=
